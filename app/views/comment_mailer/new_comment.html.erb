<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
  </head>
  <body>
    <h2>New comment on "<%= @post.title %>"</h2>
    
    <p>
      <strong><%= @commenter.name %></strong> commented:
    </p>
    
    <blockquote style="border-left: 3px solid #ccc; margin-left: 0; padding-left: 16px; color: #666;">
      <%= simple_format(@comment.body) %>
    </blockquote>
    
    <p>
      <%= link_to "View the full discussion", post_url(@post), style: "color: #5b4dd0; text-decoration: none; font-weight: bold;" %>
    </p>
    
    <hr style="border: none; border-top: 1px solid #ccc; margin: 24px 0;" />
    
    <p style="color: #999; font-size: 12px;">
      You received this email because you published a post on our blog.
    </p>
  </body>
</html>
