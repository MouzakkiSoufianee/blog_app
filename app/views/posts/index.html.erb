<% content_for :title, "Posts" %>

<section class="hero">
  <div>
    <h1>Stories that matter.</h1>
    <p>Read the latest posts and share your voice. Thoughtful writing, clear authorship, and lively discussion.</p>
    <div class="post-actions">
      <%= link_to "Write a post", new_post_path, class: "btn" %>
      <%= link_to "Browse all", posts_path, class: "btn btn-ghost" %>
    </div>
  </div>
  <div class="hero-card">
    <p class="meta">Fresh perspectives</p>
    <p class="lede">Every post shows its author and invites comments. Join in with your own insights.</p>
  </div>
</section>

<div class="form-card" style="margin-bottom: 24px;">
  <%= form_with url: posts_path, method: :get, local: true do |form| %>
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
      <div class="form-group" style="flex: 1; min-width: 200px; margin: 0;">
        <%= form.label :status, "Status" %>
        <%= form.select :status, 
            options_for_select([["All", ""], ["Published", "published"], ["Drafts", "drafts"]], params[:status]), 
            {}, 
            { onchange: "this.form.requestSubmit()" } %>
      </div>

      <div class="form-group" style="flex: 1; min-width: 200px; margin: 0;">
        <%= form.label :author_id, "Author" %>
        <%= form.collection_select :author_id, 
            @users, 
            :id, 
            :name, 
            { prompt: "All authors", selected: params[:author_id] }, 
            { onchange: "this.form.requestSubmit()" } %>
      </div>

      <div class="form-group" style="flex: 2; min-width: 250px; margin: 0;">
        <%= form.label :query, "Search" %>
        <div style="display: flex; gap: 8px;">
          <%= form.text_field :query, 
              value: params[:query], 
              placeholder: "Search title or body..." %>
          <%= form.submit "Search", class: "btn" %>
        </div>
      </div>
    </div>
    
    <% if params[:status].present? || params[:author_id].present? || params[:query].present? %>
      <%= link_to "Clear filters", posts_path, class: "btn btn-ghost", style: "margin-top: 12px;" %>
    <% end %>
  <% end %>
</div>

<h2 class="section-title">Latest posts</h2>

<% if @posts.any? %>
  <ul class="grid-list">
    <%= render @posts %>
  </ul>
<% else %>
  <p>No posts yet.</p>
<% end %>
