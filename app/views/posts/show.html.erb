<% content_for :title, @post.title %>

<%= turbo_frame_tag "drawer" do %>
  <div class="drawer-close">
    <%= link_to "✕ Close", posts_path, class: "btn btn-ghost" %>
  </div>

  <div class="card" style="margin: 0;">
    <div class="post-head">
      <h1><%= @post.title %></h1>
      <p class="meta">By <%= @post.user.name %> • <%= render "posts/status_badge", post: @post, id_suffix: :status_show, show_timestamp: true %> • <%= pluralize(@post.comments_count, "comment") %></p>
    </div>

    <div class="lede" style="margin: 18px 0;">
      <%= simple_format(@post.body) %>
    </div>

    <%= render "posts/actions", post: @post %>

    <h2 class="section-title" style="margin-top: 24px;">Comments</h2>

    <%= turbo_frame_tag "comments" do %>
      <% if @post.comments.any? %>
        <ul class="comment-list">
          <%= render @post.comments %>
        </ul>
      <% else %>
        <p>No comments yet.</p>
      <% end %>
    <% end %>

    <h3 class="section-title">Add a comment</h3>

    <% if @comment&.errors&.any? %>
      <div class="errors">
        <h2><%= pluralize(@comment.errors.count, "error") %> prohibited this comment from being saved:</h2>
        <ul>
          <% @comment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-card">
      <%= form_with model: [@post, (@comment || Comment.new)], id: "new_comment_form" do |form| %>
        <p class="meta" style="margin: 0 0 12px;">Commenting as <strong><%= current_user&.name || "Guest" %></strong></p>

        <div class="form-group">
          <%= form.label :body, "Comment" %>
          <%= form.text_area :body, rows: 4, required: true %>
        </div>

        <%= form.submit "Post comment", class: "btn" %>
      <% end %>
    </div>
  </div>
<% end %>
