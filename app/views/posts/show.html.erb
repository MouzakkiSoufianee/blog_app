<% content_for :title, @post.title %>

<%= turbo_frame_tag "drawer" do %>
  <div class="drawer-close">
    <%= link_to "✕ Close", posts_path, class: "btn btn-ghost" %>
  </div>

  <div class="card" style="margin: 0;">
    <div class="post-head">
      <h1><%= @post.title %></h1>
      <p class="meta">By <%= @post.user.name %> • <strong><%= @post.status.humanize %></strong> • <%= pluralize(@post.comments_count, "comment") %></p>
      <% if @post.published_at.present? %>
        <p class="meta">Published <%= l(@post.published_at, format: :long) %></p>
      <% end %>
    </div>

    <div class="lede" style="margin: 18px 0;">
      <%= simple_format(@post.body) %>
    </div>

    <div class="post-actions" style="margin-top: 18px; display: flex; gap: 8px; flex-wrap: wrap;">
      <%= link_to "Edit", edit_post_path(@post), class: "btn", 
          style: "background: linear-gradient(145deg, rgba(147, 197, 253, 0.14), rgba(96, 165, 250, 0.16)); border-color: var(--accent);",
          data: { turbo_frame: "drawer" } %>
      <%= button_to "Delete", post_path(@post), method: :delete, 
          class: "btn", 
          style: "background: linear-gradient(145deg, rgba(248, 113, 113, 0.14), rgba(239, 68, 68, 0.16)); border-color: var(--danger);",
          form: { data: { turbo_confirm: "Are you sure you want to delete this post?" } } %>
    </div>

    <h2 class="section-title" style="margin-top: 24px;">Comments</h2>

    <%= turbo_frame_tag "comments" do %>
      <% if @post.comments.any? %>
        <ul class="comment-list">
          <%= render @post.comments %>
        </ul>
      <% else %>
        <p>No comments yet.</p>
      <% end %>
    <% end %>

    <h3 class="section-title">Add a comment</h3>

    <% if @comment&.errors&.any? %>
      <div class="errors">
        <h2><%= pluralize(@comment.errors.count, "error") %> prohibited this comment from being saved:</h2>
        <ul>
          <% @comment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-card">
      <%= form_with model: [@post, (@comment || Comment.new)], id: "new_comment_form" do |form| %>
        <div class="form-group">
          <%= form.label :user_id, "Author" %>
          <%= form.collection_select :user_id, @users, :id, :name, { prompt: "Select author" }, { required: true } %>
        </div>

        <div class="form-group">
          <%= form.label :body, "Comment" %>
          <%= form.text_area :body, rows: 4, required: true %>
        </div>

        <%= form.submit "Post comment", class: "btn" %>
      <% end %>
    </div>
  </div>
<% end %>
