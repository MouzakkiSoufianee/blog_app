<% id_suffix ||= :status %>
<% show_timestamp ||= false %>

<%= turbo_frame_tag dom_id(post, id_suffix), class: "status-badge", data: { turbo_action: "advance" }, style: "display: inline-flex; align-items: center; gap: 6px;" do %>
  <span class="badge" style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: <%= post.published? ? "rgba(34,197,94,0.12)" : "rgba(148,163,184,0.18)" %>; color: <%= post.published? ? "#15803d" : "#0f172a" %>;">
    <span style="width: 8px; height: 8px; border-radius: 50%; display: inline-block; background: <%= post.published? ? "#22c55e" : "#cbd5e1" %>;"></span>
    <%= post.status.humanize %>
  </span>
  <% if show_timestamp && post.published_at.present? %>
    <span class="meta" style="margin-left: 8px;">Published <%= l(post.published_at, format: :short) %></span>
  <% elsif show_timestamp %>
    <span class="meta" style="margin-left: 8px;">Draft</span>
  <% end %>
<% end %>
