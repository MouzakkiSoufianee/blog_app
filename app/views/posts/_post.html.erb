<li class="card" id="<%= dom_id(post) %>">
  <% if post.cover_image.attached? %>
    <%= image_tag post.cover_image.variant(resize_to_limit: [400, 250]), style: "width: 100%; height: 250px; object-fit: cover; border-radius: 8px; margin-bottom: 12px;" %>
  <% end %>
  <h2><%= link_to post.title, post, data: { turbo_frame: "_top" } %></h2>
  <p class="meta">By <%= post.user.name %> • <%= render "posts/status_badge", post: post %> • <%= pluralize(post.comments_count, "comment") %></p>
  <p class="lede"><%= truncate(post.body, length: 140) %></p>
  <div class="post-actions">
    <%= link_to "View", post_path(post), class: "btn btn-view", 
        data: { turbo_frame: "drawer" } %>
    <% if user_signed_in? && allowed_to?(:edit?, post) %>
      <%= link_to "Edit", edit_post_path(post), class: "btn btn-edit", 
          data: { turbo_frame: "drawer" } %>
    <% end %>
    <% if user_signed_in? && allowed_to?(:destroy?, post) %>
      <%= button_to "Delete", post_path(post), method: :delete, 
          class: "btn btn-delete",
        form: { data: { turbo_confirm: "Delete this post? Its comments will be removed too.", confirm_title: "Delete post", confirm_action: "Delete", confirm_cancel: "Keep it", confirm_kicker: "Heads up" } } %>
    <% end %>
  </div>
</li>
