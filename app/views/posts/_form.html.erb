<% if post.errors.any? %>
  <div class="errors">
    <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>
    <ul>
      <% post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="form-card">
  <%= form_with model: post do |form| %>
    <p class="meta" style="margin: 0 0 12px;">Author: <strong><%= current_user&.name || "Unknown" %></strong></p>

    <div class="form-group">
      <%= form.label :title %>
      <%= form.text_field :title, required: true %>
    </div>

    <div class="form-group">
      <%= form.label :body %>
      <%= form.text_area :body, rows: 8, required: true %>
    </div>

    <div class="form-group">
      <%= form.label :cover_image, "Cover Image" %>
      <%= form.file_field :cover_image, accept: "image/jpeg,image/png,image/webp" %>
      <% if post.cover_image.attached? %>
        <p class="meta">Current image:</p>
        <%= image_tag post.cover_image, style: "max-width: 200px; height: auto;" %>
      <% end %>
    </div>

    <div class="form-group">
      <%= form.label :status, "Status" %>
      <%= form.select :status, 
          options_for_select(Post.statuses.keys, post.status), 
          {}, 
          { required: true } %>
    </div>

    <div class="form-group">
      <%= form.label :published_at, "Published at" %>
      <%= form.datetime_field :published_at %>
    </div>

    <%= form.submit "Save post", class: "btn" %>
  <% end %>
</div>
