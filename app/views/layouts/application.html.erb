<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ticket" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ticket">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script type="module">
      import * as Turbo from 'https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.10/+esm'
      import { Application, Controller } from 'https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/+esm'
      
      // Start Stimulus
      const application = Application.start()
      window.Stimulus = application
      
      // Register search controller
      class SearchController extends Controller {
        static targets = ["form"]
        static values = { delay: { type: Number, default: 300 } }

        connect() {
          this.timeout = null
          console.log("Search controller connected")
        }

        search() {
          console.log("Search triggered")
          clearTimeout(this.timeout)
          
          this.timeout = setTimeout(() => {
            console.log("Submitting form")
            this.formTarget.requestSubmit()
          }, this.delayValue)
        }

        submit(event) {
          clearTimeout(this.timeout)
        }
      }
      
      application.register("search", SearchController)

      // Styled confirmation prompt to replace the native confirm dialog
      Turbo.setConfirmMethod((message, element) => {
        return new Promise((resolve) => {
          const overlay = document.createElement("div")
          overlay.className = "confirm-overlay"

          const dialog = document.createElement("div")
          dialog.className = "confirm-dialog"
          dialog.tabIndex = -1

          const kicker = document.createElement("p")
          kicker.className = "confirm-kicker"
          kicker.textContent = element?.dataset?.confirmKicker || "Blog action"

          const title = document.createElement("h3")
          title.className = "confirm-title"
          title.textContent = element?.dataset?.confirmTitle || "Please confirm"

          const body = document.createElement("p")
          body.className = "confirm-message"
          body.textContent = message

          const actions = document.createElement("div")
          actions.className = "confirm-actions"

          const cancelButton = document.createElement("button")
          cancelButton.type = "button"
          cancelButton.className = "btn btn-ghost btn-sm"
          cancelButton.textContent = element?.dataset?.confirmCancel || "Cancel"

          const confirmButton = document.createElement("button")
          confirmButton.type = "button"
          confirmButton.className = "btn btn-danger btn-sm"
          confirmButton.textContent = element?.dataset?.confirmAction || "Delete"

          const cleanup = (result) => {
            overlay.remove()
            resolve(result)
          }

          cancelButton.addEventListener("click", () => cleanup(false))
          confirmButton.addEventListener("click", () => cleanup(true))

          overlay.addEventListener("click", (event) => {
            if (event.target === overlay) cleanup(false)
          })

          overlay.addEventListener("keydown", (event) => {
            if (event.key === "Escape") cleanup(false)
            if (event.key === "Enter") cleanup(true)
          })

          actions.appendChild(cancelButton)
          actions.appendChild(confirmButton)
          dialog.appendChild(kicker)
          dialog.appendChild(title)
          dialog.appendChild(body)
          dialog.appendChild(actions)
          overlay.appendChild(dialog)
          document.body.appendChild(overlay)

          // Focus for keyboard users
          setTimeout(() => dialog.focus(), 10)
        })
      })
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="page">
    <header class="page-header">
      <nav class="top-nav">
        <div class="brand">Ticket Blog</div>
        <div class="nav-actions">
          <%= link_to "Home", root_path, class: "nav-link" %>
          <%= link_to "Posts", posts_path, class: "nav-link" %>
          <% if user_signed_in? %>
            <%= link_to "New Post", new_post_path, class: "btn btn-ghost" %>
            <span style="color: #999; font-size: 0.875rem;">
              Signed in as <%= current_user.email %>
            </span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, form: { "data-turbo": false }, class: "btn btn-ghost" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "btn btn-ghost" %>
            <%= link_to "Sign up", new_user_registration_path, class: "btn btn-ghost" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="page-main">
      <% flash.each do |type, message| %>
        <div class="flash <%= type %>"><%= message %></div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Drawer for New/Edit/View -->
    <%= turbo_frame_tag "drawer", target: "_top" do %>
    <% end %>
    <div id="drawer-backdrop"></div>

    <script>
      document.addEventListener('turbo:load', () => {
        const drawer = document.querySelector('turbo-frame#drawer');
        const backdrop = document.getElementById('drawer-backdrop');
        
        if (!drawer || !backdrop) return;
        
        // Check drawer content and show/hide backdrop
        const checkDrawer = () => {
          const hasContent = drawer.innerHTML.trim() !== '' && drawer.children.length > 0;
          if (hasContent) {
            drawer.classList.add('show');
            backdrop.classList.add('show');
          } else {
            drawer.classList.remove('show');
            backdrop.classList.remove('show');
          }
        };
        
        // Watch for Turbo Frame loads
        drawer.addEventListener('turbo:frame-load', checkDrawer);
        drawer.addEventListener('turbo:frame-render', checkDrawer);
        
        // Watch for DOM changes
        const observer = new MutationObserver(checkDrawer);
        observer.observe(drawer, { childList: true, subtree: true });
        
        // Close drawer when backdrop is clicked
        backdrop.addEventListener('click', () => {
          drawer.innerHTML = '';
          drawer.classList.remove('show');
          backdrop.classList.remove('show');
        });
        
        // Initial check
        checkDrawer();
      });
    </script>
  </body>
</html>
