<%= turbo_frame_tag dom_id(comment) do %>
  <li class="comment-item">
    <div><strong><%= comment.user.name %>:</strong></div>
    <div class="lede"><%= simple_format(comment.body) %></div>
    <p class="comment-meta"><%= comment.created_at ? l(comment.created_at, format: :short) : "Just now" %></p>
    <div style="display: flex; gap: 8px; margin-top: 8px;">
      <%= link_to "Edit", edit_post_comment_path(comment.post, comment), class: "btn btn-ghost", data: { turbo_frame: dom_id(comment) } %>
      <%= button_to "Delete", [comment.post, comment], method: :delete, 
          class: "btn btn-ghost", 
          style: "color: var(--danger);",
          form: { data: { turbo_confirm: "Delete this comment?" } } %>
    </div>
  </li>
<% end %>
