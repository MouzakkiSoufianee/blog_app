<%= turbo_stream.append "comments" do %>
  <%= render @comment %>
<% end %>

<%= turbo_stream.update "new_comment_form" do %>
  <%= form_with model: [@post, Comment.new], id: "new_comment_form" do |form| %>
    <div class="form-group">
      <%= form.label :user_id, "Author" %>
      <%= form.collection_select :user_id, User.order(:name), :id, :name, { prompt: "Select author" }, { required: true } %>
    </div>

    <div class="form-group">
      <%= form.label :body, "Comment" %>
      <%= form.text_area :body, rows: 4, required: true %>
    </div>

    <%= form.submit "Post comment", class: "btn" %>
  <% end %>
<% end %>
