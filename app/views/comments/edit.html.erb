<%= turbo_frame_tag dom_id(@comment) do %>
  <li class="comment-item">
    <div class="form-card" style="margin: 0;">
      <h4 style="margin-top: 0;">Edit Comment</h4>
      
      <%= form_with model: [@post, @comment] do |form| %>
        <div class="form-group">
          <%= form.label :user_id, "Author" %>
          <%= form.collection_select :user_id, @users, :id, :name, {}, { required: true } %>
        </div>

        <div class="form-group">
          <%= form.label :body, "Comment" %>
          <%= form.text_area :body, rows: 4, required: true %>
        </div>

        <div style="display: flex; gap: 8px;">
          <%= form.submit "Update comment", class: "btn" %>
          <%= link_to "Cancel", post_path(@post), class: "btn btn-ghost", data: { turbo_frame: dom_id(@comment) } %>
        </div>
      <% end %>
    </div>
  </li>
<% end %>
